{
  "routes": [
    { "route": "/api/ping", "allowedRoles": ["anonymous"] },

    { "route": "/api/plaid/webhook", "allowedRoles": ["anonymous"] },
    { "route": "/bank/link-complete", "allowedRoles": ["anonymous"] },

    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/access-denied", "allowedRoles": ["anonymous"] },
    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/.auth/*", "/access-denied"]
  },
  "responseOverrides": {
    "401": { "redirect": "/.auth/login/aad", "statusCode": 302 },
    "403": { "redirect": "/access-denied", "statusCode": 302 }
  }
}